{
  "name": "maafight",
  "version": "2.0.0-alpha.0",
  "description": "Corpus-driven Arknights MAA copilot v2 generator (CLI + GUI)",
  "main": "dist/index.js",
  "bin": {
    "maafight": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "node scripts/clean-dist.js && tsc",
    "build:web": "vite build --config web/vite.config.ts",
    "gui": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-mumu.ps1 && npm run build && node dist/index.js gui",
    "release:preview": "npm run build && node scripts/release-preview.js",
    "start": "node dist/index.js",
    "benchmark": "node scripts/benchmark.js",
    "corpus:audit": "node scripts/build-corpus-model.js --audit-only",
    "model:build": "node scripts/build-corpus-model.js",
    "combat-data:build": "node scripts/build-operator-combat-model.js",
    "battle-dsl": "node scripts/battle-dsl.js",
    "enumerate-candidates": "node scripts/enumerate-candidates.js",
    "build-action-dataset": "node scripts/build-action-dataset.js",
    "train-linear-ranker": "python scripts/model-core/train_linear_ranker.py",
    "eval-ranker": "python scripts/model-core/eval_ranker.py",
    "generate-script": "node scripts/generate-script.js",
    "record-feedback": "node scripts/record-feedback.js",
    "shadow-core": "node scripts/model-core-shadow.js",
    "model-core-retrain": "node scripts/model-core-retrain.js",
    "model-core-decision": "node scripts/model-core-decision.js",
    "model-core-smoke-test": "npm run build:node && node scripts/model-core-smoke-test.js --skipBuild",
    "verify": "tsc && jest --coverage && node scripts/benchmark.js --skip-build",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "fastify": "^5.8.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
