{
  "name": "maafight",
  "version": "1.0.0-alpha",
  "description": "Preview local Arknights MAA copilot script generator (CLI + GUI)",
  "main": "dist/index.js",
  "bin": {
    "maafight": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:node": "tsc",
    "build:web": "vite build --config web/vite.config.ts",
    "gui": "npm run build && node dist/index.js gui",
    "release:preview": "npm run build && node scripts/release-preview.js",
    "start": "node dist/index.js",
    "benchmark": "node scripts/benchmark.js",
    "verify": "tsc && jest --coverage && node scripts/benchmark.js --skip-build",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "fastify": "^5.8.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
